{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "extensions": {
    "mcp": {
      "serverName": "octotrip-flights-mock",
      "serverVersion": "1.0.0",
      "instructions": "Mock stand-in for the OctoTrip Flights MCP server. The 'search' tool returns synthetic flight offers generated from the request; the data is not real.",
      "system": {
        "webhookAuthorizationLevel": "Anonymous"
      }
    }
  }
}
